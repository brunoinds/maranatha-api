{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "avadim/fast-excel-writer": "~6.6.4",
        "berkayk/onesignal-laravel": "^2.5",
        "beyondcode/laravel-server-timing": "^1.7",
        "brick/math": "^1.0",
        "brunoinds/currency-getgeo-api-laravel": "^1.0.3",
        "brunoinds/frankfurter-laravel": "^1.0",
        "brunoinds/paraguay-dolar-laravel": "^2.0.0",
        "brunoinds/sunat-dolar-laravel": "^1.0.2",
        "chillerlan/php-qrcode": "^5.0",
        "codedge/laravel-fpdf": "^1.13",
        "devdojo/google-image-search": "^0.2",
        "dompdf/dompdf": "^3.1",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.2",
        "ilovepdf/ilovepdf-php": "^1.2",
        "intervention/image": "^4.4",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "masbug/flysystem-google-drive-ext": "^2.4",
        "mikehaertl/php-shellcommand": "^1.7",
        "predis/predis": "^3.3",
        "sentry/sentry-laravel": "^4.29",
        "setasign/fpdf": "1.8.*",
        "setasign/fpdi": "^2.5",
        "softinklab/laravel-keyvalue-storage": "^1.8",
        "spatie/laravel-backup": "^10.3",
        "spatie/temporary-directory": "^2.2",
        "staudenmeir/eloquent-has-many-deep": "^1.22",
        "staudenmeir/eloquent-json-relations": "^1.15"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Functions/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.5.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
